{
  "schema_version": 1,
  "content_schema_version": 2,
  "locale_schema_version": 1,
  "default_locale": "zh-CN",
  "supported_locales": [
    "zh-CN"
  ],
  "id": "hyouka",
  "name": "冰菓·古典部推理",
  "version": "1.3.0",
  "min_app_version": "2.5.0",
  "description": "以《冰菓》（古典部系列）为蓝本的日常推理内容包：校园谜题、观察与询问、限时推理。推理靠脑力、骰子只决定信息获取。非官方同人，版权归原作所有。",
  "compatible_rulesets": [
    "hyouka_rule"
  ],
  "plugin_type": "content-pack",
  "content_profile": "content-pack",
  "content_delivery_mode": "legacy_autoimport",
  "license": "MIT",
  "config_schema": "config.schema.json",
  "capabilities": [
    "content.rule",
    "content.world",
    "content.character-template"
  ],
  "permissions": [
    "plugin.config",
    "content.read",
    "content.import"
  ],
  "contributes": {
    "rules": [
      "content/rules/*.json"
    ],
    "world_templates": [
      "content/worlds/*.json"
    ],
    "character_templates": [
      "content/characters/*.json"
    ],
    "npcs": [
      "content/npc/*.json"
    ],
    "items": [
      "content/items/*.json"
    ],
    "spells": [
      "content/spells/*.json"
    ],
    "classes": [
      "content/classes/*.json"
    ]
  },
  "docs": "README_CN.md"
}
